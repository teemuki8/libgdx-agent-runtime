{
  "steps": [
    {
      "name": "sessions",
      "tool": "runtime_sessions",
      "arguments": {},
      "dispatch": false,
      "expectedContains": ["controlled-workflow-example"]
    },
    {
      "name": "capabilities",
      "tool": "runtime_capabilities",
      "arguments": {
        "sessionId": "controlled-workflow-example",
        "protocolMinor": 13
      },
      "dispatch": false,
      "expectedContains": ["simulation-control", "registered-inputs"]
    },
    {
      "name": "scenarios",
      "tool": "runtime_scenarios",
      "arguments": {"sessionId": "controlled-workflow-example"},
      "dispatch": false,
      "expectedContains": ["walk"]
    },
    {
      "name": "reset",
      "tool": "runtime_reset",
      "arguments": {
        "sessionId": "controlled-workflow-example",
        "scenarioId": "walk",
        "resetRequestId": "transcript-reset",
        "timeoutNanos": 5000000000
      },
      "dispatch": true,
      "expectedContains": ["SUCCEEDED", "executionEpochId"]
    },
    {
      "name": "pause",
      "tool": "runtime_control",
      "arguments": {
        "sessionId": "controlled-workflow-example",
        "action": "PAUSE",
        "controlRequestId": "transcript-pause",
        "timeoutNanos": 5000000000
      },
      "dispatch": true,
      "expectedContains": ["SUCCEEDED", "PAUSE", "paused"]
    },
    {
      "name": "input",
      "tool": "runtime_input",
      "arguments": {
        "sessionId": "controlled-workflow-example",
        "input": "set-velocity",
        "inputRequestId": "transcript-input",
        "parameters": {"velocityX": 2},
        "targetTick": 1,
        "timeoutNanos": 5000000000
      },
      "dispatch": true,
      "expectedContains": ["SCHEDULED", "actualTick"]
    },
    {
      "name": "advance",
      "tool": "runtime_simulation_advance",
      "arguments": {
        "sessionId": "controlled-workflow-example",
        "controlRequestId": "transcript-advance",
        "ticks": 2,
        "timeoutNanos": 5000000000
      },
      "dispatch": true,
      "expectedContains": ["SUCCEEDED", "completedTicks", "2"]
    },
    {
      "name": "entity",
      "tool": "runtime_entity",
      "arguments": {
        "sessionId": "controlled-workflow-example",
        "entityId": "player"
      },
      "dispatch": false,
      "expectedContains": ["position", "velocity"]
    },
    {
      "name": "events",
      "tool": "runtime_events",
      "arguments": {
        "sessionId": "controlled-workflow-example",
        "fromFrame": 0,
        "toFrame": 3,
        "eventType": "player.moved",
        "eventTypePrefix": false,
        "limit": 10
      },
      "dispatch": false,
      "expectedContains": ["player.moved", "position"]
    },
    {
      "name": "frame assertion",
      "tool": "runtime_assert",
      "arguments": {
        "sessionId": "controlled-workflow-example",
        "fromFrame": 0,
        "toFrame": 3,
        "executionEpochId": 1,
        "evidenceLimit": 8,
        "assertion": {
          "assertionType": "eventOccurs",
          "eventType": "player.moved"
        }
      },
      "dispatch": false,
      "expectedContains": ["PASS", "eventOccurs", "player.moved"]
    },
    {
      "name": "assertion",
      "tool": "runtime_simulation_assert",
      "arguments": {
        "sessionId": "controlled-workflow-example",
        "executionEpochId": 1,
        "fromEpochTick": 1,
        "toEpochTick": 2,
        "evidenceLimit": 8,
        "evidenceRequirements": [],
        "assertion": {
          "assertionType": "vectorApproximatelyEquals",
          "entityId": "player",
          "property": "position",
          "expected": {"x": 0.04, "y": 0},
          "absoluteTolerance": 0.0001,
          "toleranceMode": "COMPONENT"
        }
      },
      "dispatch": false,
      "expectedContains": ["PASS", "vectorApproximatelyEquals", "observed"]
    },
    {
      "name": "determinism",
      "tool": "runtime_simulation_determinism_check",
      "arguments": {
        "sessionId": "controlled-workflow-example",
        "determinismRequestId": "transcript-determinism",
        "scenarioId": "walk",
        "randomSeed": 7,
        "configuration": [],
        "repeatCount": 2,
        "ticksPerRepeat": 2,
        "deltaNanos": 10000000,
        "profile": {
          "comparisonScope": {
            "entityIds": ["player"],
            "properties": ["position", "velocity"],
            "excludedProperties": [],
            "includeEvents": false,
            "includeDecisions": false
          },
          "includeUiCorrelations": false
        },
        "inputs": [
          {
            "epochTick": 1,
            "inputId": "set-velocity",
            "parameters": {"velocityX": 2}
          }
        ],
        "configurationRequirements": [],
        "evidenceRequirements": [],
        "eventTypes": [],
        "timeoutNanos": 5000000000
      },
      "dispatch": true,
      "expectedContains": ["EQUAL", "divergence", "whole-program determinism is not proven"]
    }
  ]
}
